generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────
// ENUMS
// ─────────────────────────────────────

enum Role {
  ADMIN
  INVENTORY_MANAGER
  CASHIER
}

enum BrandState {
  ACTIVE
  INACTIVE
  DISCONNECT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  RETURNED
  COUNTING_ERROR
  SYSTEM_CORRECTION
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

// ─────────────────────────────────────
// MODELS
// ─────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  bills            Bill[]
  grns             GoodsReceivingNote[]
  stockAdjustments StockAdjustment[]
  refunds          Refund[]
  notificationStates UserNotificationState[]

  // Relations to new Combo Suggestion models
  createdCombos          Combo[]                @relation("CreatedCombos")
  approvedCombos         Combo[]                @relation("ApprovedCombos")
  comboApprovalHistories ComboApprovalHistory[]
  comboNotifications     ComboNotification[]

  @@map("users")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  companyName String   @map("company_name")
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  grns                 GoodsReceivingNote[]
  masterProductClasses MasterProductClass[]

  @@map("suppliers")
}

model Category {
  id               String   @id @default(uuid()) @map("category_id")
  name             String   @unique
  description      String?
  categoryImageUrl String?  @map("category_image_url")
  isActive         Boolean  @default(true) @map("is_active")

  // Relations
  subCategories        SubCategory[]
  masterProductClasses MasterProductClass[]

  // Relations to new Combo Suggestion models
  sourceCategoryAssociations CategoryAssociation[] @relation("SourceCategoryAssociations")
  targetCategoryAssociations CategoryAssociation[] @relation("TargetCategoryAssociations")

  @@map("categories")
}

model SubCategory {
  id          String   @id @default(uuid()) @map("subc_id")
  name        String   @unique
  description String?
  categoryId  String   @map("category_id")
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  category             Category             @relation(fields: [categoryId], references: [id])
  masterProductClasses MasterProductClass[]

  @@map("sub_categories")
}

model Brand {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  state       BrandState @default(ACTIVE)

  // Relations
  masterProductClasses MasterProductClass[]

  @@map("brands")
}

model MasterProductClass {
  id            String       @id @default(uuid())
  name          String
  categoryId    String       @map("category_id")
  subCategoryId String?      @map("subcategory_id")
  brandId       String       @map("brand_id")
  supplierId    String       @map("supplier_id")
  hasVariant    Boolean      @default(false) @map("has_varient")
  createdAt     DateTime     @default(now()) @map("created_at")

  // Relations
  category    Category     @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
  brand       Brand        @relation(fields: [brandId], references: [id])
  supplier    Supplier     @relation(fields: [supplierId], references: [id])
  products    Product[]

  // Relations to new Combo Suggestion models
  antecedentRules ProductAssociationRule[] @relation("AntecedentClassRules")
  consequentRules ProductAssociationRule[] @relation("ConsequentClassRules")

  @@map("master_product_class")
}

model Product {
  sku                  String        @id @map("sku")
  masterId             String        @map("master_id")
  barcode              String        @unique
  name                 String
  unitType             String        @map("unit_type")
  costPrice            Float         @map("cost_price")
  sellingPrice         Float         @map("selling_price")
  discount             Float?        @default(0)
  currentStock         Int           @default(0) @map("current_stock")
  reorderLevel         Int           @default(25) @map("reorder_level")
  targetCapacity       Int           @map("target_capacity")
  mfgDate              DateTime?     @map("mfg_date") @db.Date
  expiryDate           DateTime?     @map("expiry_date") @db.Date
  status               ProductStatus @default(ACTIVE)
  imageUrl             String?       @map("image_url")
  batchNumber          String?       @map("batch_number")
  seasonal             String?       
  variantAttributeType String?       @map("variant_attribute_type")
  lowOrderLevel        Boolean?      @map("low_order_level")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  masterClass      MasterProductClass @relation(fields: [masterId], references: [id])
  grnItems         GrnItem[]
  stockAdjustments StockAdjustment[]
  billItems        BillItem[]
  discountProducts DiscountProduct[]
  comboItems       DiscountComboItem[]
  refundItems      RefundItem[]
  notifications    Notification[]
  demandAnalyses   DemandAnalysis[]
  demandForecasts  DemandForecast[]

  // Relations to new Combo Suggestion models
  antecedentAssociationRules ProductAssociationRule[]    @relation("AntecedentRules")
  consequentAssociationRules ProductAssociationRule[]    @relation("ConsequentRules")
  substituteRelations        ProductSubstituteRelation[] @relation("ProductSubstitutes")
  substitutedByRelations     ProductSubstituteRelation[] @relation("ProductSubstitutedBy")
  seasonalProductAnalyses    SeasonalProductAnalysis[]
  seasonalRulesA             SeasonalAssociationRule[]   @relation("SeasonalRulesA")
  seasonalRulesB             SeasonalAssociationRule[]   @relation("SeasonalRulesB")
  comboOpportunities         ComboOpportunity[]
  comboAnchorCandidates      ComboAnchorCandidate[]
  comboSuggestionsTarget     ComboSuggestion[]           @relation("TargetSuggestions")
  comboSuggestionsAnchor     ComboSuggestion[]           @relation("AnchorSuggestions")
  comboSuggestionItems       ComboSuggestionItem[]
  comboItemsNew              ComboItem[]

  @@map("products")
}

model GoodsReceivingNote {
  id         String   @id @default(uuid())
  grnId      String   @unique @map("grn_id")
  supplierId String   @map("supplier_id")
  operatorId String   @map("operator_id")
  grnDate    DateTime @default(now()) @map("grn_date")
  notes      String?

  // Relations
  supplier Supplier  @relation(fields: [supplierId], references: [id])
  operator User      @relation(fields: [operatorId], references: [id])
  items    GrnItem[]

  @@map("goods_receiving_notes")
}

model GrnItem {
  id            String    @id @default(uuid())
  grnId         String    @map("grn_id")
  sku           String    @map("sku")
  addedQuantity Int       @map("added_quantity")
  finalQuantity Int       @map("final_quantity")
  unitCost      Float     @map("unit_cost")
  mfd           DateTime? @db.Date
  epd           DateTime? @db.Date

  // Relations
  grn     GoodsReceivingNote @relation(fields: [grnId], references: [id])
  product Product            @relation(fields: [sku], references: [sku])

  // Relations to new Combo Suggestion models
  comboOpportunities   ComboOpportunity[]
  comboSuggestionItems ComboSuggestionItem[]
  comboItemsNew        ComboItem[]

  @@map("grn_items")
}

model StockAdjustment {
  id            String           @id @default(uuid())
  sku           String           @map("sku")
  qtyChanged    Int              @map("qty_changed")
  reason        AdjustmentReason
  adjustedById  String           @map("adjusted_by")
  finalQuantity Int              @map("final_quantity")
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  product    Product @relation(fields: [sku], references: [sku])
  adjustedBy User    @relation(fields: [adjustedById], references: [id])

  @@map("stock_adjustments")
}

model Bill {
  id             String        @id @default(uuid())
  billNumber     String        @unique @map("bill_number")
  cashierId      String        @map("cashier_id")
  subtotal       Float
  totalDiscount  Float?        @default(0) @map("total_discount")
  totalBill      Float         @map("total_bill")
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  draft          Boolean       @default(false)
  totalQty       Int           @map("total_qty")
  paidAmount     Float?        @map("paid_amount")
  changeAmount   Float?        @map("change_amount")
  createdAt      DateTime      @default(now()) @map("created_at")

  // Relations
  cashier   User       @relation(fields: [cashierId], references: [id])
  billItems BillItem[]
  refunds   Refund[]

  // Relations to new Combo Suggestion models
  comboSales ComboSale[]

  @@map("sales_bills")
}

model BillItem {
  id            String  @id @default(uuid())
  billId        String  @map("bill_id")
  sku           String  @map("sku")
  qty           Int
  unitPrice     Float   @map("unit_price")
  total         Float
  discountId    String? @map("discount_id")
  discountValue Float?  @map("discount_value")

  // Relations
  bill     Bill      @relation(fields: [billId], references: [id])
  product  Product   @relation(fields: [sku], references: [sku])
  discount Discount? @relation(fields: [discountId], references: [id])

  @@map("sales_bill_items")
}

enum DiscountType {
  SEASONAL
  DAILY
  COMBO
  BILL
}

enum ApprovalStatus {
  DRAFT
  APPROVED
}

model Discount {
  id             String         @id @default(uuid())
  name           String
  type           DiscountType
  discountValue  Float          @default(0) @map("discount_value")
  comboPrice     Float?         @map("combo_price")
  minBillAmount  Float?         @map("min_bill_amount")
  label          String?
  imageUrl       String?        @map("image_url")
  startDate      DateTime?      @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  dailyStartTime String?        @map("daily_start_time")
  dailyEndTime   String?        @map("daily_end_time")
  applicableDate DateTime?      @map("applicable_date") @db.Date
  isActive       Boolean        @default(true) @map("is_active")
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  discountProducts DiscountProduct[]
  comboItems       DiscountComboItem[]
  billItems        BillItem[]

  @@map("discounts")
}

model DiscountProduct {
  id         String   @id @default(uuid())
  discountId String   @map("discount_id")
  sku        String   @map("sku")

  // Relations
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@unique([discountId, sku])
  @@map("seasonal_or_daily_products")
}

model DiscountComboItem {
  id         String   @id @default(uuid())
  discountId String   @map("discount_id")
  sku        String   @map("sku")
  minQty     Int      @default(1) @map("min_qty")

  // Relations
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@unique([discountId, sku])
  @@map("discount_combo_items")
}

model Refund {
  id              String       @id @default(uuid())
  refundNumber    String       @unique @map("refund_number")
  originalBillId  String       @map("original_bill_id")
  cashierId       String       @map("cashier_id")
  refundAmount    Float        @map("refund_amount")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  originalBill    Bill         @relation(fields: [originalBillId], references: [id])
  cashier         User         @relation(fields: [cashierId], references: [id])
  refundItems     RefundItem[]

  @@map("sales_refunds")
}

model RefundItem {
  id            String   @id @default(uuid())
  refundId      String   @map("refund_id")
  sku           String   @map("sku")
  qty           Int
  refundValue   Float    @map("refund_value")

  // Relations
  refund        Refund   @relation(fields: [refundId], references: [id])
  product       Product  @relation(fields: [sku], references: [sku])

  @@map("sales_refund_items")
}

model GeneratedReport {
  id            String   @id @default(uuid())
  name          String
  category      String
  format        String
  status        String   @default("Ready")
  createdByRole String   @default("ADMIN") @map("created_by_role")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("generated_reports")
}

model SystemSetting {
  id        String   @id @default("global")
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────
// NOTIFICATIONS SCHEMA
// ─────────────────────────────────────

enum NotificationType {
  DISCOUNT_APPROVAL
  DISCOUNT_RESPONSE
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
  EXPIRING_SOON
  EXPIRED
  DEMAND_FORECAST
  STOCK_VELOCITY
  COMBO_SUGGESTION
  SYSTEM
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

model Notification {
  id              String               @id @default(uuid())
  type            NotificationType
  severity        NotificationSeverity @default(INFO)
  title           String
  message         String
  sku             String?              @map("sku")
  suggestedAction String?              @map("suggested_action")
  metadata        Json?                // Stores dynamic data (e.g. discountId, forecastQty, combo items)
  targetRole      Role?                @map("target_role") // Targeted to Role (ADMIN, INVENTORY_MANAGER, etc.)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Relations
  product         Product?             @relation(fields: [sku], references: [sku], onDelete: Cascade)
  userStates      UserNotificationState[]

  @@map("notifications")
}

model UserNotificationState {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  notificationId String       @map("notification_id")
  isRead         Boolean      @default(false) @map("is_read")
  isDismissed    Boolean      @default(false) @map("is_dismissed")
  readAt         DateTime?    @map("read_at")
  dismissedAt    DateTime?    @map("dismissed_at")

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("user_notification_states")
}

// ─────────────────────────────────────
// AI DEMAND FORECASTING MODELS
// ─────────────────────────────────────

model DemandForecastRun {
  id                    String    @id @default(uuid())
  targetMonth           DateTime  @map("target_month") @db.Date
  version               Int       @default(1)
  status                String
  triggerType           String    @default("MANUAL") @map("trigger_type")
  dataStartDate         DateTime  @map("data_start_date") @db.Date
  dataEndDate           DateTime  @map("data_end_date") @db.Date
  startedAt             DateTime? @map("started_at")
  completedAt           DateTime? @map("completed_at")
  requestedBy           String?   @map("requested_by")
  totalProducts         Int       @default(0) @map("total_products")
  successCount          Int       @default(0) @map("success_count")
  failureCount          Int       @default(0) @map("failure_count")
  configurationSnapshot Json?     @map("configuration_snapshot")
  errorMessage          String?   @map("error_message")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  analyses              DemandAnalysis[]
  forecasts             DemandForecast[]

  // Relations to new Combo Suggestion models
  comboOpportunities ComboOpportunity[]

  @@index([targetMonth])
  @@map("demand_forecast_runs")
}

model DemandAnalysis {
  id                         String   @id @default(uuid())
  forecastRunId              String   @map("forecast_run_id")
  productId                  String   @map("product_id")
  usableHistoryDays          Int      @map("usable_history_days")
  completeHistoryMonths      Int      @map("complete_history_months")
  dataQuality                String   @map("data_quality")
  recent30Sales              Int      @map("recent_30_sales")
  previous30Sales            Int      @map("previous_30_sales")
  recentGrowthPercentage     Float?   @map("recent_growth_percentage")
  threeMonthAverage          Float    @map("three_month_average")
  sixMonthAverage            Float    @map("six_month_average")
  twelveMonthAverage         Float?   @map("twelve_month_average")
  sameMonthHistoricalAverage Float?   @map("same_month_historical_average")
  seasonalUpliftPercentage   Float?   @map("seasonal_uplift_percentage")
  discountUpliftPercentage   Float?   @map("discount_uplift_percentage")
  refundQuantity             Int      @default(0) @map("refund_quantity")
  refundRate                 Float    @default(0.0) @map("refund_rate")
  stockOutDays               Int      @default(0) @map("stock_out_days")
  stockOutRatio              Float    @default(0.0) @map("stock_out_ratio")
  zeroSalesRatio             Float    @default(0.0) @map("zero_sales_ratio")
  coefficientOfVariation     Float    @default(0.0) @map("coefficient_of_variation")
  averageDemandInterval      Float    @default(0.0) @map("average_demand_interval")
  trendSlope                 Float    @default(0.0) @map("trend_slope")
  primaryBehaviour           String   @map("primary_behaviour")
  trendDirection             String   @map("trend_direction")
  additionalBehaviourTags    Json     @map("additional_behaviour_tags")
  analysisWarnings           Json?    @map("analysis_warnings")
  createdAt                  DateTime @default(now()) @map("created_at")

  forecastRun DemandForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [sku])

  @@unique([forecastRunId, productId])
  @@index([productId])
  @@map("demand_analysis")
}

model DemandForecast {
  id                       String   @id @default(uuid())
  forecastRunId            String   @map("forecast_run_id")
  productId                String   @map("product_id")
  targetMonth              DateTime @map("target_month") @db.Date
  currentStock             Int      @map("current_stock")
  confirmedIncomingStock   Int      @default(0) @map("confirmed_incoming_stock")
  predictedDemand          Int      @map("predicted_demand")
  safetyStock              Int      @map("safety_stock")
  requiredStock            Int      @map("required_stock")
  recommendedOrderQuantity Int      @map("recommended_order_quantity")
  stockCoverageDays        Float?   @map("stock_coverage_days")
  selectedModel            String   @map("selected_model")
  modelParameters          Json?    @map("model_parameters")
  MAE                      Float?   @map("mae")
  RMSE                     Float?   @map("rmse")
  WAPE                     Float?   @map("wape")
  accuracyScore            Float?   @map("accuracy_score")
  reliabilityLevel         String   @map("reliability_level")
  predictionReason         String   @map("prediction_reason")
  status                   String
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  forecastRun DemandForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [sku])

  @@unique([forecastRunId, productId])
  @@index([productId])
  @@index([targetMonth])
  @@index([status])
  @@map("demand_forecasts")
}

// ─────────────────────────────────────
// COMBO & SUGGESTION MODULE MODELS
// ─────────────────────────────────────

model ComboBusinessSetting {
  id           String   @id @default(uuid()) @map("id")
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  dataType     String   @map("data_type")
  description  String?  @map("description")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("combo_business_settings")
}

model ProductAssociationRun {
  id                String   @id @default(uuid()) @map("id")
  analysisStartDate DateTime @map("analysis_start_date") @db.Date
  analysisEndDate   DateTime @map("analysis_end_date") @db.Date
  algorithm         String   @map("algorithm")
  minimumSupport    Float    @map("minimum_support")
  minimumConfidence Float    @map("minimum_confidence")
  minimumLift       Float    @map("minimum_lift")
  transactionCount  Int      @map("transaction_count")
  productCount      Int      @map("product_count")
  status            String   @map("status")
  startedAt         DateTime @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  errorMessage      String?  @map("error_message")
  version           Int      @default(1) @map("version")
  createdBy         String?  @map("created_by")

  // Relations
  rules                ProductAssociationRule[]
  categoryAssociations CategoryAssociation[]
  comboOpportunities   ComboOpportunity[]

  @@map("product_association_runs")
}

model ProductAssociationRule {
  id                       String   @id @default(uuid()) @map("id")
  associationRunId         String   @map("association_run_id")
  antecedentProductId      String   @map("antecedent_product_id")
  consequentProductId      String   @map("consequent_product_id")
  antecedentFamilyId       String?  @map("antecedent_family_id")
  consequentFamilyId       String?  @map("consequent_family_id")
  pairPurchaseCount        Int      @map("pair_purchase_count")
  antecedentPurchaseCount  Int      @map("antecedent_purchase_count")
  consequentPurchaseCount  Int      @map("consequent_purchase_count")
  support                  Float    @map("support")
  confidence               Float    @map("confidence")
  reverseConfidence        Float    @map("reverse_confidence")
  lift                     Float    @map("lift")
  weightedSupport          Float    @map("weighted_support")
  stabilityMonthCount      Int      @map("stability_month_count")
  stabilityYearCount       Int      @map("stability_year_count")
  largeBasketRatio         Float    @map("large_basket_ratio")
  categoryCompatibilityScore Float  @map("category_compatibility_score")
  familyCompatibilityScore Float    @map("family_compatibility_score")
  substituteRiskScore      Float    @map("substitute_risk_score")
  relationshipScore        Float    @map("relationship_score")
  relationshipStatus       String   @map("relationship_status")
  firstObservedDate        DateTime? @map("first_observed_date") @db.Date
  lastObservedDate         DateTime? @map("last_observed_date") @db.Date
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations
  associationRun     ProductAssociationRun @relation(fields: [associationRunId], references: [id], onDelete: Cascade)
  antecedentProduct  Product               @relation("AntecedentRules", fields: [antecedentProductId], references: [sku])
  consequentProduct  Product               @relation("ConsequentRules", fields: [consequentProductId], references: [sku])
  antecedentFamily   MasterProductClass?   @relation("AntecedentClassRules", fields: [antecedentFamilyId], references: [id])
  consequentFamily   MasterProductClass?   @relation("ConsequentClassRules", fields: [consequentFamilyId], references: [id])
  anchorCandidates   ComboAnchorCandidate[]

  @@unique([associationRunId, antecedentProductId, consequentProductId])
  @@index([antecedentProductId])
  @@index([consequentProductId])
  @@index([relationshipScore])
  @@map("product_association_rules")
}

model CategoryAssociation {
  id                 String   @id @default(uuid()) @map("id")
  sourceCategoryId   String   @map("source_category_id")
  targetCategoryId   String   @map("target_category_id")
  pairCount          Int      @map("pair_count")
  support            Float    @map("support")
  confidence         Float    @map("confidence")
  lift               Float    @map("lift")
  relationshipScore  Float    @map("relationship_score")
  relationshipStatus String   @map("relationship_status")
  analysisRunId      String   @map("analysis_run_id")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  sourceCategory Category              @relation("SourceCategoryAssociations", fields: [sourceCategoryId], references: [id])
  targetCategory Category              @relation("TargetCategoryAssociations", fields: [targetCategoryId], references: [id])
  analysisRun    ProductAssociationRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, sourceCategoryId, targetCategoryId])
  @@map("category_associations")
}

model ProductSubstituteRelation {
  id                  String   @id @default(uuid()) @map("id")
  productId           String   @map("product_id")
  substituteProductId String   @map("substitute_product_id")
  detectionSource     String   @map("detection_source")
  substituteScore     Float    @map("substitute_score")
  status              String   @map("status")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  product           Product @relation("ProductSubstitutes", fields: [productId], references: [sku])
  substituteProduct Product @relation("ProductSubstitutedBy", fields: [substituteProductId], references: [sku])

  @@unique([productId, substituteProductId])
  @@map("product_substitute_relations")
}

model SeasonalEvent {
  id                 String   @id @default(uuid()) @map("id")
  name               String   @map("name")
  description        String?  @map("description")
  eventType          String   @map("event_type")
  analysisStartMonth Int      @map("analysis_start_month")
  analysisStartDay   Int      @map("analysis_start_day")
  analysisEndMonth   Int      @map("analysis_end_month")
  analysisEndDay     Int      @map("analysis_end_day")
  targetYear         Int?     @map("target_year")
  createdBy          String?  @map("created_by")
  status             String   @map("status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  productAnalyses    SeasonalProductAnalysis[]
  associationRules   SeasonalAssociationRule[]
  comboOpportunities ComboOpportunity[]

  @@map("seasonal_events")
}

model SeasonalProductAnalysis {
  id                       String   @id @default(uuid()) @map("id")
  seasonalEventId          String   @map("seasonal_event_id")
  productId                String   @map("product_id")
  historicalYear           Int      @map("historical_year")
  seasonalSales            Float    @map("seasonal_sales")
  normalPeriodSales        Float    @map("normal_period_sales")
  seasonalUpliftPercentage Float    @map("seasonal_uplift_percentage")
  seasonalDemandScore      Float    @map("seasonal_demand_score")
  repeatedYearCount        Int      @map("repeated_year_count")
  forecastedDemand         Float?   @map("forecasted_demand")
  expectedExcessStock      Float?   @map("expected_excess_stock")
  isSeasonal               Boolean  @map("is_seasonal")
  confidenceLevel          String   @map("confidence_level")
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations
  seasonalEvent SeasonalEvent @relation(fields: [seasonalEventId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [sku])

  @@unique([seasonalEventId, productId, historicalYear])
  @@map("seasonal_product_analyses")
}

model SeasonalAssociationRule {
  id                String   @id @default(uuid()) @map("id")
  seasonalEventId   String   @map("seasonal_event_id")
  productAId        String   @map("product_a_id")
  productBId        String   @map("product_b_id")
  pairCount         Int      @map("pair_count")
  support           Float    @map("support")
  confidence        Float    @map("confidence")
  lift              Float    @map("lift")
  relationshipScore Float    @map("relationship_score")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  seasonalEvent SeasonalEvent @relation(fields: [seasonalEventId], references: [id], onDelete: Cascade)
  productA      Product       @relation("SeasonalRulesA", fields: [productAId], references: [sku])
  productB      Product       @relation("SeasonalRulesB", fields: [productBId], references: [sku])

  @@unique([seasonalEventId, productAId, productBId])
  @@map("seasonal_association_rules")
}

model ComboOpportunity {
  id                       String   @id @default(uuid()) @map("id")
  forecastRunId            String   @map("forecast_run_id")
  associationRunId         String   @map("association_run_id")
  seasonalEventId          String?  @map("seasonal_event_id")
  targetProductId          String   @map("target_product_id")
  targetBatchId            String?  @map("target_batch_id")
  opportunityType          String   @map("opportunity_type")
  velocityClass            String   @map("velocity_class")
  currentStock             Int      @map("current_stock")
  availableStock           Int      @map("available_stock")
  predictedDemand          Int      @map("predicted_demand")
  safetyStock              Int      @map("safety_stock")
  requiredStock            Int      @map("required_stock")
  stockCoverageDays        Float    @map("stock_coverage_days")
  excessStock              Int      @map("excess_stock")
  daysSinceLastSale        Int      @map("days_since_last_sale")
  expiryDate               DateTime? @map("expiry_date") @db.Date
  daysToExpiry             Int?     @map("days_to_expiry")
  seasonalUpliftPercentage Float?   @map("seasonal_uplift_percentage")
  priorityScore            Float    @map("priority_score")
  opportunityStatus        String   @map("opportunity_status")
  detectedAt               DateTime @default(now()) @map("detected_at")
  expiresAt                DateTime? @map("expires_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  forecastRun      DemandForecastRun     @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)
  associationRun   ProductAssociationRun @relation(fields: [associationRunId], references: [id], onDelete: Cascade)
  seasonalEvent    SeasonalEvent?        @relation(fields: [seasonalEventId], references: [id])
  targetProduct    Product               @relation(fields: [targetProductId], references: [sku])
  targetBatch      GrnItem?              @relation(fields: [targetBatchId], references: [id])
  anchorCandidates ComboAnchorCandidate[]
  comboSuggestions ComboSuggestion[]

  @@unique([forecastRunId, associationRunId, targetProductId, targetBatchId, opportunityType])
  @@index([targetProductId])
  @@index([opportunityType])
  @@index([opportunityStatus])
  @@map("combo_opportunities")
}

model ComboAnchorCandidate {
  id                       String   @id @default(uuid()) @map("id")
  opportunityId            String   @map("opportunity_id")
  anchorProductId          String   @map("anchor_product_id")
  associationRuleId        String   @map("association_rule_id")
  pairPurchaseCount        Int      @map("pair_purchase_count")
  support                  Float    @map("support")
  confidence               Float    @map("confidence")
  lift                     Float    @map("lift")
  relationshipScore        Float    @map("relationship_score")
  anchorVelocityClass      String   @map("anchor_velocity_class")
  anchorCurrentStock       Int      @map("anchor_current_stock")
  anchorPredictedDemand    Int      @map("anchor_predicted_demand")
  anchorSafetyStock        Int      @map("anchor_safety_stock")
  anchorPromotionalStock   Int      @map("anchor_promotional_stock")
  anchorStockCoverageDays  Float    @map("anchor_stock_coverage_days")
  anchorStockOutRisk       Float    @map("anchor_stock_out_risk")
  normalProfitContribution Float    @map("normal_profit_contribution")
  compatibilityScore       Float    @map("compatibility_score")
  stockSafetyScore         Float    @map("stock_safety_score")
  profitabilityScore       Float    @map("profitability_score")
  finalCandidateScore      Float    @map("final_candidate_score")
  candidateRank            Int      @map("candidate_rank")
  rejectionReason          String?  @map("rejection_reason")
  status                   String   @map("status")
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations
  opportunity     ComboOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  anchorProduct   Product                @relation(fields: [anchorProductId], references: [sku])
  associationRule ProductAssociationRule @relation(fields: [associationRuleId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, anchorProductId])
  @@index([opportunityId])
  @@index([finalCandidateScore])
  @@map("combo_anchor_candidates")
}

model ComboSuggestion {
  id                            String   @id @default(uuid()) @map("id")
  opportunityId                 String   @map("opportunity_id")
  suggestionVersion             Int      @default(1) @map("suggestion_version")
  targetProductId               String   @map("target_product_id")
  primaryAnchorProductId        String   @map("primary_anchor_product_id")
  comboSize                     Int      @map("combo_size")
  suggestionType                String   @map("suggestion_type")
  normalTotalPrice              Float    @map("normal_total_price")
  totalCost                     Float    @map("total_cost")
  minimumSafePrice              Float    @map("minimum_safe_price")
  recommendedPrice              Float    @map("recommended_price")
  maximumSafeDiscount           Float    @map("maximum_safe_discount")
  recommendedDiscountAmount     Float    @map("recommended_discount_amount")
  recommendedDiscountPercentage Float    @map("recommended_discount_percentage")
  expectedProfit                Float    @map("expected_profit")
  expectedMarginPercentage      Float    @map("expected_margin_percentage")
  customerSaving                Float    @map("customer_saving")
  maximumComboQuantity          Int      @map("maximum_combo_quantity")
  recommendationScore           Float    @map("recommendation_score")
  confidenceLevel               String   @map("confidence_level")
  riskLevel                     String   @map("risk_level")
  explanation                   String   @map("explanation")
  evidenceSummary               String   @map("evidence_summary")
  suggestionStatus              String   @map("suggestion_status")
  generatedAt                   DateTime @default(now()) @map("generated_at")
  expiresAt                     DateTime? @map("expires_at")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  // Relations
  opportunity          ComboOpportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  targetProduct        Product                    @relation("TargetSuggestions", fields: [targetProductId], references: [sku])
  primaryAnchorProduct Product                    @relation("AnchorSuggestions", fields: [primaryAnchorProductId], references: [sku])
  items                ComboSuggestionItem[]
  evidence             ComboSuggestionEvidence[]
  combos               Combo[]
  notifications        ComboNotification[]

  @@index([opportunityId])
  @@index([suggestionStatus])
  @@map("combo_suggestions")
}

model ComboSuggestionItem {
  id                        String   @id @default(uuid()) @map("id")
  comboSuggestionId         String   @map("combo_suggestion_id")
  productId                 String   @map("product_id")
  batchId                   String?  @map("batch_id")
  role                      String   @map("role")
  quantity                  Int      @map("quantity")
  normalUnitPrice           Float    @map("normal_unit_price")
  costPrice                 Float    @map("cost_price")
  allocatedDiscount         Float    @map("allocated_discount")
  effectiveSellingPrice     Float    @map("effective_selling_price")
  availablePromotionalStock Int      @map("available_promotional_stock")
  relationshipScore         Float    @map("relationship_score")
  createdAt                 DateTime @default(now()) @map("created_at")

  // Relations
  comboSuggestion ComboSuggestion @relation(fields: [comboSuggestionId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [sku])
  batch           GrnItem?        @relation(fields: [batchId], references: [id])

  @@map("combo_suggestion_items")
}

model ComboSuggestionEvidence {
  id                String   @id @default(uuid()) @map("id")
  comboSuggestionId String   @map("combo_suggestion_id")
  evidenceType      String   @map("evidence_type")
  evidenceKey       String   @map("evidence_key")
  evidenceValue     String   @map("evidence_value")
  unit              String?  @map("unit")
  description       String   @map("description")
  sourceTable       String?  @map("source_table")
  sourceRecordId    String?  @map("source_record_id")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  comboSuggestion ComboSuggestion @relation(fields: [comboSuggestionId], references: [id], onDelete: Cascade)

  @@map("combo_suggestion_evidences")
}

model Combo {
  id                          String   @id @default(uuid()) @map("id")
  sourceSuggestionId          String?  @map("source_suggestion_id")
  comboCode                   String   @unique @map("combo_code")
  name                        String   @map("name")
  description                 String?  @map("description")
  comboType                   String   @map("combo_type")
  normalTotalPrice            Float    @map("normal_total_price")
  comboPrice                  Float    @map("combo_price")
  discountAmount              Float    @map("discount_amount")
  discountPercentage          Float    @map("discount_percentage")
  totalCost                   Float    @map("total_cost")
  expectedProfit              Float    @map("expected_profit")
  expectedMarginPercentage    Float    @map("expected_margin_percentage")
  maximumQuantity             Int      @map("maximum_quantity")
  soldQuantity                Int      @default(0) @map("sold_quantity")
  startDate                   DateTime @map("start_date") @db.Date
  endDate                     DateTime @map("end_date") @db.Date
  status                      String   @map("status")
  createdByInventoryManagerId String   @map("created_by_inventory_manager_id")
  submittedAt                 DateTime? @map("submitted_at")
  approvedByAdminId           String?  @map("approved_by_admin_id")
  approvedAt                  DateTime? @map("approved_at")
  rejectionReason             String?  @map("rejection_reason")
  requestChangeMessage        String?  @map("request_change_message")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  // Relations
  sourceSuggestion          ComboSuggestion?        @relation(fields: [sourceSuggestionId], references: [id])
  createdByInventoryManager User                    @relation("CreatedCombos", fields: [createdByInventoryManagerId], references: [id])
  approvedByAdmin           User?                   @relation("ApprovedCombos", fields: [approvedByAdminId], references: [id])
  items                     ComboItem[]
  approvals                 ComboApprovalHistory[]
  sales                     ComboSale[]
  performances              ComboPerformance[]
  notifications             ComboNotification[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("combos")
}

model ComboItem {
  id                String   @id @default(uuid()) @map("id")
  comboId           String   @map("combo_id")
  productId         String   @map("product_id")
  batchId           String?  @map("batch_id")
  role              String   @map("role")
  quantity          Int      @map("quantity")
  normalUnitPrice   Float    @map("normal_unit_price")
  costPrice         Float    @map("cost_price")
  allocatedDiscount Float    @map("allocated_discount")
  effectivePrice    Float    @map("effective_price")
  stockReserved     Int      @default(0) @map("stock_reserved")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  combo   Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [sku])
  batch   GrnItem? @relation(fields: [batchId], references: [id])

  @@unique([comboId, productId])
  @@map("combo_items")
}

model ComboApprovalHistory {
  id              String   @id @default(uuid()) @map("id")
  comboId         String   @map("combo_id")
  action          String   @map("action")
  previousStatus  String   @map("previous_status")
  newStatus       String   @map("new_status")
  performedBy     String   @map("performed_by")
  performedByRole String   @map("performed_by_role")
  comment         String?  @map("comment")
  performedAt     DateTime @default(now()) @map("performed_at")

  // Relations
  combo     Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  performer User  @relation(fields: [performedBy], references: [id])

  @@map("combo_approval_histories")
}

model ComboSale {
  id                       String   @id @default(uuid()) @map("id")
  comboId                  String   @map("combo_id")
  saleId                   String   @map("sale_id")
  quantity                 Int      @map("quantity")
  normalValue              Float    @map("normal_value")
  comboValue               Float    @map("combo_value")
  customerSaving           Float    @map("customer_saving")
  totalCost                Float    @map("total_cost")
  realizedProfit           Float    @map("realized_profit")
  realizedMarginPercentage Float    @map("realized_margin_percentage")
  soldAt                   DateTime @default(now()) @map("sold_at")

  // Relations
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  sale  Bill  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@map("combo_sales")
}

model ComboPerformance {
  id                          String   @id @default(uuid()) @map("id")
  comboId                     String   @map("combo_id")
  evaluationStartDate         DateTime @map("evaluation_start_date") @db.Date
  evaluationEndDate           DateTime @map("evaluation_end_date") @db.Date
  impressions                 Int      @default(0) @map("impressions")
  viewCount                   Int      @default(0) @map("view_count")
  purchaseCount               Int      @default(0) @map("purchase_count")
  unitsSold                   Int      @default(0) @map("units_sold")
  revenueGenerated            Float    @default(0.0) @map("revenue_generated")
  profitGenerated             Float    @default(0.0) @map("profit_generated")
  customerSavings             Float    @default(0.0) @map("customer_savings")
  targetStockCleared          Int      @default(0) @map("target_stock_cleared")
  expiryWasteAvoidedQuantity  Int      @default(0) @map("expiry_waste_avoided_quantity")
  normalTargetSalesBaseline   Float    @default(0.0) @map("normal_target_sales_baseline")
  promotionalTargetSales      Float    @default(0.0) @map("promotional_target_sales")
  salesUpliftPercentage       Float    @default(0.0) @map("sales_uplift_percentage")
  anchorNormalSalesImpact     Float    @default(0.0) @map("anchor_normal_sales_impact")
  status                      String   @map("status")
  calculatedAt                DateTime @default(now()) @map("calculated_at")

  // Relations
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@map("combo_performance")
}

model ComboNotification {
  id                String    @id @default(uuid()) @map("id")
  userId            String    @map("user_id")
  userRole          String    @map("user_role")
  comboSuggestionId String?   @map("combo_suggestion_id")
  comboId           String?   @map("combo_id")
  notificationType  String    @map("notification_type")
  title             String    @map("title")
  message           String    @map("message")
  priority          String    @map("priority")
  isRead            Boolean   @default(false) @map("is_read")
  createdAt         DateTime  @default(now()) @map("created_at")
  readAt            DateTime? @map("read_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comboSuggestion ComboSuggestion? @relation(fields: [comboSuggestionId], references: [id])
  combo           Combo?           @relation(fields: [comboId], references: [id])

  @@map("combo_notifications")
}
